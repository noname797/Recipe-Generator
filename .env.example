# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# AWS credentials used by langchain-aws / boto3 to call Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only required if using temporary/STS credentials (access key ID starting
# with "ASIA" rather than "AKIA") — e.g. from `aws sts assume-role`, AWS SSO,
# or an instance/container credential provider. Leave unset for a permanent
# IAM user access key pair.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Server-side session storage (see flask-session docs). Defaults to
# filesystem storage in ./.flask_session if unset. Use "redis" in production
# and configure SESSION_REDIS accordingly.
SESSION_TYPE=filesystem
SESSION_FILE_DIR=./.flask_session

# Logging verbosity for app.py (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# SQLite file used to persist escalated sessions for human review.
ESCALATION_DB_PATH=./escalations.db
